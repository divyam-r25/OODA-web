{
  "name": "ooda",
  "version": "2.0.0",
  "private": true,
  "description": "OODA: competitive intelligence for founders and product teams (web app).",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "ollama:bridge": "node scripts/ollama-bridge.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1",
    "test:e2e": "node --import tsx tests/e2e/run.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
