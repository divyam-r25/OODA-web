# Copy to .env and edit. `npm run dev` and `npm start` load .env automatically.
# Everything here is read by the SERVER only. Nothing is ever sent to the browser.

# ── Server ───────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1                 # use 0.0.0.0 inside a container
DATABASE_PATH=./data/ooda.sqlite
NODE_ENV=development           # set to "production" when deployed behind HTTPS
COOKIE_SECURE=                 # blank = true in production, false otherwise. Requires HTTPS when true.
TRUST_PROXY=false              # true only behind a reverse proxy that sets X-Forwarded-For
ALLOW_REGISTRATION=true        # set false after you have created your accounts
SESSION_DAYS=14

# ── Analysis provider (pick ONE) ─────────────────────────
# With AI_PROVIDER unset or "none", pages are still collected and saved, but no reports are written.
AI_PROVIDER=none               # none | ollama | openai | anthropic
AI_TIMEOUT_MS=120000

# Ollama (local, private)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=                  # e.g. a model you have pulled with `ollama pull`

# OpenAI or any OpenAI-compatible server
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=               # e.g. claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Collection ───────────────────────────────────────────
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=4
RESPECT_ROBOTS=true
FETCH_USER_AGENT=              # blank = "OODA-Research/2.0 (+competitive-intelligence; respects robots.txt)"
ALLOW_PRIVATE_FETCH=false      # NEVER enable on a server reachable by other people (disables SSRF protection)

# ── Worker and limits ────────────────────────────────────
WORKER_ENABLED=true            # runs research jobs in-process
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=3
MAX_ACTIVE_RUNS=3
MAX_RUNS_PER_DAY=40
MAX_COMPETITORS=50
MAX_SOURCES_PER_COMPETITOR=6
