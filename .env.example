# Copy to .env and edit. `npm run dev` and `npm start` load .env automatically.
# Everything here is read by the SERVER only. Nothing is ever sent to the browser.
# NON-NEGOTIABLE ZERO-COST POLICY: All recommended modes below operate with a strict ₹0 / $0 budget.

# ── Server ───────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1                 # Use 0.0.0.0 inside a container or on Render
DATABASE_PATH=./data/ooda.sqlite
NODE_ENV=development           # Set to "production" when deployed behind HTTPS
COOKIE_SECURE=                 # Blank = true in production, false otherwise. Requires HTTPS when true.
TRUST_PROXY=false              # True only behind a reverse proxy that sets X-Forwarded-For
TRUSTED_ORIGINS=               # Comma-separated exact browser origins allowed through a reverse proxy, e.g. https://your-site.vercel.app
ALLOW_REGISTRATION=true        # Set false after you have created your accounts
SESSION_DAYS=14

# ── Zero-Cost AI Provider (pick ONE) ─────────────────────
# Options:
#   - "ollama": Genuinely unlimited, private, local offline inference on your machine.
#   - "openrouter_free": Hosted zero-cost inference for cloud deployments (e.g. Render). Accepts ONLY free models ending in ':free'.
#   - "mock": Deterministic test provider for fast offline development/testing ($0, no language model).
#   - "none": Collects and stores evidence/snapshots without writing AI reports.
AI_PROVIDER=openrouter_free
AI_TIMEOUT_MS=120000

# ── Workflow Mode ────────────────────────────────────────
#   - "single": Single-agent prompt generating complete OODA analysis.
#   - "multi_agent": 4-role sequential pipeline (Research Analyst -> Strategy Analyst -> Skeptical Reviewer -> Lead Synthesizer).
AI_WORKFLOW=single

# ── Mode A: Local Ollama (Local PC / Private Server) ─────
# Truly unlimited zero-inference billing. Requires local Ollama installed (https://ollama.com).
# IMPORTANT CLOUD NOTICE: 127.0.0.1 on cloud hosts (e.g. Render) refers to the host container,
# NOT your personal computer. Local PC Ollama is not reachable from Render. Use openrouter_free on Render.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional role-specific models for multi-agent mode (leave blank to use OLLAMA_MODEL):
OLLAMA_ANALYST_MODEL=
OLLAMA_STRATEGIST_MODEL=
OLLAMA_CRITIC_MODEL=
OLLAMA_SYNTHESIS_MODEL=

# ── Mode B: OpenRouter Free (Render & Hosted Cloud) ──────
# Free-tier hosted inference with zero billing. Get a free key at https://openrouter.ai/keys (no credit card needed).
# SECURITY & ZERO-COST ENFORCEMENT: Only model identifiers ending in ':free' (or 'openrouter/free') are accepted.
# Paid models (e.g. openai/gpt-4o) are strictly rejected to guarantee $0 cost.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional free role models for multi-agent mode (must end in ':free'):
OPENROUTER_ANALYST_MODEL=
OPENROUTER_STRATEGIST_MODEL=
OPENROUTER_CRITIC_MODEL=
OPENROUTER_SYNTHESIS_MODEL=

# ── Optional Paid Adapters (Existing Legacy Adapters) ────
# Note: These are optional and not needed for zero-cost operation.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Collection ───────────────────────────────────────────
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=4
RESPECT_ROBOTS=true
FETCH_USER_AGENT=              # Blank = "OODA-Research/2.0 (+competitive-intelligence; respects robots.txt)"
ALLOW_PRIVATE_FETCH=false      # NEVER enable on a server reachable by other people (disables SSRF protection)

# ── Worker and limits ────────────────────────────────────
WORKER_ENABLED=true            # Runs research jobs in-process
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=3
MAX_ACTIVE_RUNS=3
MAX_RUNS_PER_DAY=40
MAX_COMPETITORS=50
MAX_SOURCES_PER_COMPETITOR=6
